# smoke - the smallest interesting datacenter: two racks, one pipeline, no
# constraint binding except compute. Used by the tests as the baseline.

room closet power_cap_kw=60 cool_cap_kw=30 supply_c=22 spine_gbps=400

rackgroup row room=closet racks=2 pdu_cap_kw=40 uplink_gbps=100 recirc=0.10 airflow_kw_per_c=2.0

nodetype srv cap_wu=300 idle_w=150 dyn_w=550 queue_max=256 txbl_max_kib=4096 rja_c_per_kw=25 t_throttle_c=85 t_max_c=100

stage front wu=30  bytes_kib=16 next=back   slo_ms=200
stage back  wu=100 bytes_kib=4  next=egress slo_ms=400

fill rackgroup=row type=srv stage=front per_rack=8
fill rackgroup=row type=srv stage=back  per_rack=8

load stage=front rps=400
