# chiller_fail - one row, and the cooling plant loses half its capacity at 30 s.
#
# 60 racks of 40 nodes, comfortably cooled, running at about 80% of compute
# capacity. At t=30 s two of four chillers drop out; at t=90 s they come back.
# Watch the whole chain in one run: supply air climbs, dies cross 80 C, clocks
# fall, throughput drops, and because throttled nodes make less heat the hall
# finds a hotter equilibrium instead of running away. Then it recovers on the
# boost ramp, which is slower than the collapse.
#
# This is the visual scenario: --frames gives one PPM per tick group, 60 racks
# across by 40 nodes tall, coloured by die temperature.

room hall power_cap_kw=2400 cool_cap_kw=2000 supply_c=22 spine_gbps=800

rackgroup row room=hall racks=60 pdu_cap_kw=40 uplink_gbps=40 recirc=0.15 airflow_kw_per_c=2.2 vgrad_c=9

nodetype srv cap_wu=400 idle_w=180 dyn_w=620 queue_max=256 txbl_max_kib=8192 rja_c_per_kw=26 t_throttle_c=80 t_max_c=95

stage serve wu=50 bytes_kib=32 next=egress slo_ms=400

fill rackgroup=row type=srv stage=serve per_rack=40

# 2400 nodes x 8 req/tick = 19200 req/tick of capacity; ask for 95% of it
load stage=serve rps=182400

fault at_s=30 target=hall cool_cap_kw=750
fault at_s=90 target=hall cool_cap_kw=2000
